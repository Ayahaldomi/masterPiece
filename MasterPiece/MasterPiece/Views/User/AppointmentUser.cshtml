<script>
    // error model


    var errorModal = document.getElementById("errorModal");

    var closeErrorModal = errorModal.querySelector(".close");

    // Function to open the error modal with a custom message
    function showErrorModal(message) {
        document.getElementById("errorMessage").textContent = message;
        errorModal.style.display = "block";
    }

    closeErrorModal.onclick = function () {
        errorModal.style.display = "none";
    };

    window.onclick = function (event) {
        if (event.target == errorModal) {
            errorModal.style.display = "none";
        }
    };

    // Function to validate form inputs
    function validateForm() {

        const appointmentForm = document.getElementById('appointmentForm');

        const selectedDate = document.getElementById('preferred_date').value;
        const selectedTime = document.getElementById('time_value').innerText;
        const combinedDateTime = selectedDate + "T" + selectedTime;

        document.getElementById('dateOfAppointment').value = combinedDateTime;

        const fields = [
            { id: 'email', label: 'Full Name' },
            { id: 'password', label: 'Date of Birth' },
            { id: 'gender', label: 'Gender' },
            { id: 'user_name', label: 'Email Address' },
            { id: 'first_name', label: 'Phone Number' },
            { id: 'last_name', label: 'Home Address' },
            { id: 'dateOfAppointment', label: 'Preferred Date' },

        ];

        let missingFields = [];

        fields.forEach(field => {
            let input = document.getElementById(field.id);
            if (!input || !input.value) {
                missingFields.push(field.label);
            }
        });

        if (missingFields.length > 0) {
            let message = "Please fill in the following fields:\n" + missingFields.join(', ');
            showErrorModal(message);
            return false;
        }

        return true;
    }
</script>




